# Copy to .env and fill in. .env is gitignored - never commit real keys.
#
#   Copy-Item .env.example .env
#
# The app reads this file on startup, so RESTART the backend after editing.
# Flask's auto-reloader does not watch .env.

# ---------------------------------------------------------------- LLM
# REQUIRED. This app will not fabricate interactions: with no key configured
# the graph endpoint returns zero edges and explains why.
#
# With only a key set, Groq is assumed. That is all you need for Groq:
PROTEIN_LLM_API_KEY=

# Optional overrides.
# PROTEIN_LLM_BACKEND=groq
# PROTEIN_LLM_MODEL=openai/gpt-oss-120b
# PROTEIN_LLM_BASE_URL=https://api.groq.com/openai/v1

# Groq retires models, so if extraction starts failing with HTTP 404, list what
# your key can use and update PROTEIN_LLM_MODEL:
#
#   curl.exe -s -H "Authorization: Bearer <your key>" `
#     https://api.groq.com/openai/v1/models
#
# Other providers (all OpenAI-compatible):
#   PROTEIN_LLM_BACKEND=openai
#   PROTEIN_LLM_BASE_URL=https://api.openai.com/v1
#   PROTEIN_LLM_MODEL=gpt-4o-mini
#
#   PROTEIN_LLM_BACKEND=ollama      # local, no key needed
#   PROTEIN_LLM_BASE_URL=http://localhost:11434/v1
#   PROTEIN_LLM_MODEL=llama3.1

# How many abstracts to send per graph request. One LLM call per abstract, and
# Groq's free tier allows ~8000 tokens/min, so this is the main cost/speed
# dial. Lower it if you hit 429s; raise it for a denser graph.
# PROTEIN_LLM_MAX_ABSTRACTS=20

# Minimum seconds between LLM calls.
# PROTEIN_LLM_MIN_INTERVAL=0.6

# ---------------------------------------------------------------- PubMed
# NCBI asks for a real contact address. Without it you are capped at 3 req/s.
NCBI_EMAIL=

# Optional: raises the cap to 10 req/s
# https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
